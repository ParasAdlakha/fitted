# Copy to .env.local and fill in. Never commit .env.local.
# Anything left empty runs on a local stand-in, so the app always starts.

# Supabase > Project Settings > API. Run supabase/schema.sql in the SQL editor first.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode secret key (sk_test_...). Connect must be enabled in the dashboard.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8790/webhooks/stripe` (optional; the success page also confirms payment)
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=DE
# Optional: an onboarded test connected account that `npm run seed` attaches to the demo businesses
STRIPE_DEMO_ACCOUNT=
PLATFORM_FEE_PERCENT=3

# OpenAI key. Used only when an owner sets up or changes their app.
OPENAI_API_KEY=
# AI_MODEL=gpt-5-mini

PORT=8790
BASE_URL=http://localhost:8790
